* {
  scrollbar-color: $surface-lighten-1 60%;
  scrollbar-color-hover: $primary 80%;
  scrollbar-color-active: $primary;
  scrollbar-background: $surface-darken-1;
  scrollbar-background-hover: $surface-darken-1;
  scrollbar-background-active: $surface-darken-1;
  scrollbar-size-vertical: 1;

  &:focus {
    scrollbar-color: $primary 55%;
  }
}

AutoComplete {

  /*Input {
      border-left: wide $accent;
      background: $surface;
  }*/

  & AutoCompleteList {
    color: $text-muted;
    background: transparent;
  }

  & .autocomplete--highlight-match {
    color: $text-accent;
    background: $accent-muted;
  }
}

.compact_input {
    width: 1fr;
    height: 2;
    border: vkey $foreground-darken-3;
    border-bottom: vkey $foreground-darken-3;
    border-top: none;
    margin-left: 1;
    margin-right: 1;
    border-subtitle-color: $background-lighten-3;
    border-subtitle-background: transparent;
    border-subtitle-align: left;
    background: $background 40%;
    &:focus {
        border: vkey $primary;
        border-bottom: vkey $primary;
        border-top: none;
        background: $panel 30%;
    }
}

EpisodeScreen {
    DataTable {
        border: none;
        border-top: outer $panel;
        border-title-align: left;
        border-title-color: $foreground-darken-3;
        border-left: outer $panel;
        border-right: outer $panel;
        &:focus {
          padding: 0;
          border-left: outer $accent;
          border-right: outer $accent;
          border-top: outer $accent;
      }
    }

    Tree {
        border: none;
        border-top: outer $panel;
        border-title-align: left;
        border-title-color: $foreground-darken-3;
        border-left: outer $panel;
        border-right: outer $panel;
        width: 1fr;
        min-width: 32;
        &:focus {
          padding: 0;
          border-left: outer $accent;
          border-right: outer $accent;
          border-top: outer $accent;
        }
    }

    MarkdownViewer {
        border: none;
        border-left: outer $panel;
        &:focus {
          border-left: outer $accent-lighten-3;
      }
    }

    TabbedContent {
        align-horizontal: right;
        width: 3fr;
    }

    TabPane {
    }

}

CreateEditEpisode, CreateEditProject {
    align: center middle;
    background: rgba(0, 40, 40, 0.5);
}

CreateEditEpisode {
    ScrollableContainer {
        height: auto;
    }

    Vertical {
        overflow-y: auto;
    }

    Horizontal {
        width: 1fr;
    }

    Input {
        border: round $foreground-darken-3;
        background: transparent;
        &:focus {
            border-title-color: $primary;
            border: round $primary;
        }
    }
    Collapsible {
        height: auto;
        margin-left: 1;
        margin-right: 1;
        padding-bottom: 1;
        border: none;
        border-top: outer $foreground-darken-3;
        background: $surface-lighten-1;

        &:focus-within {
            border-top: outer $accent;
        }
        TextArea {
            padding: 0;
            height: auto;
            max-height: 10
        }
    }
}

CreateEditProject {

    Vertical {
        height: 80%;
        width: 80%;
    }

    ScrollableContainer {
        min-height: 20;
        min-width: 50;
    }

    Input {
        border: none;
        border-left: outer $accent;
        height: 1;
        max-height: 1;
        &:focus {
          border-left: thick $accent-lighten-3;
          background: $background-lighten-3;
      }
    }

    #title { background: $background-lighten-1; }
    #category { background: $background-lighten-2; }

    AutoComplete {
        height: 1;
        &:focus {
          border-left: inner $accent;
          background: $background-lighten-3;
      }
      Input {
        background: $background-lighten-2;
      }
    }

    Button {
        border: vkey $accent;
        height: 3;
        padding: 0 1;
        text-style: bold;
    }

    Checkbox {
        border: panel red;
        height: 4;
        padding-top: 1;
        margin: 1;
        background: $background-lighten-1;

        Button {
            background: red;
        }
    }

    TextArea {
        border: none;
        border-left: outer $accent;
        padding: 0 0;
        min-height: 7;
        background: $background-lighten-1;
        &:focus {
          border-left: thick $accent-lighten-3;
          background: $background-lighten-3;
      }
    }
}

TemplateScreen {
    #sidebar {
        width: 1fr;
        min-width: 32;
        margin-right: 1;

    }

    #helper {
        ListItem {
            height: 1;
        }
    }

    Tree, Input, TextArea, #presufix, #helper, #tag_collapse {
        border: none;
        border-top: outer $panel;
        border-title-align: left;
        border-title-color: $foreground-darken-3;
        border-left: outer $panel;
        border-right: outer $panel;
        &:focus {
              border-left: outer $accent;
              border-right: outer $accent;
              border-top: outer $accent;
              background: $surface-lighten-1;
          }
    }

    #presufix {
        height: 4;
        &:focus-within {
              border-left: outer $accent;
              border-right: outer $accent;
              border-top: outer $accent;
              background: $surface-lighten-1;
          }
    }

    #pattern_name {
    }

    #content {
        width: 3fr;
    }

    #filter { /*compact text input line */
        border: none;
        padding-left: 1;
        border-left: outer $panel;
        border-right: outer $panel;
        background: $surface;
        &:focus {
            border-left: outer $accent;
            border-right: outer $accent;
            background: $surface-lighten-1;
        }
    }

    #pattern {
        height: 15fr;
    }

    #tag_collapse {
        padding:0;
        padding-bottom: 1;
        &:focus-within {
              border-left: outer $accent;
              border-right: outer $accent;
              border-top: outer $accent;
              background: $surface-lighten-1;
          }
    }

    #tags {
        margin: 0;
        border: none;
        padding: 0;
        height: 6;
    }

    Label {
        height: 2;
        text-align: center;
        width: 100%;
    }
}

SettingsScreen {

    #main{
        align: center top;
    }

    Input {
        max-width: 50;
    }

    #top_dog {
        align: center top;
        height: auto;
        Button {
            padding: 0;
            margin: 0;
            margin-left: 1;
            width: 1fr;
        }
        Horizontal {
            width: 55%;
            min-width: 97;
            height: auto;
            padding: 0;
            margin: 0;
        }
    }

    .settings {
        border: none;
        border-top: outer $panel;
        border-title-align: left;
        border-title-color: $foreground-darken-3;
        border-left: outer $panel;
        border-right: outer $panel;
        height: auto;
        width: 60%;
        min-width: 100;
        padding: 1;
        &:focus-within {
              border-left: outer $accent;
              border-right: outer $accent;
              border-top: outer $accent;
              background: $surface-lighten-1;
          }
    }

    Button, Checkbox {
        height: 3;
        width: 1fr;
        text-align: start;
        margin: 1;
    }

    Label {
        height: 3;
        color: $primary;
        border: ascii $accent;
        padding-left: 10;
        padding-right: 10;
    }
}

Button#save,
Button#btn_yes,
Button#btn_save
{
    background: $success 30%;
    &:hover {
        background: $success 50%;
    }
}

Button#abort
Button#btn_no,
Button#btn_abort,
Button#btn_cancel
{
    background: $error 30%;
    &:hover {
        background: $error 50%;
    }
}

.center_vert {
    padding: 0 1;
    width: 80%;
    height: 90%;
    /*max-height: 24;*/
    border: thick $background 80%;
    background: $surface;
}

Horizontal.adjust {
    align: center middle;
    Button {
        margin: 0 3;
    }
}

.title {
    padding: 1 1;
}

.max_height {
    height: 100%;
}

DebugLog {
    align: center middle;
    background: rgba(0,128,0,0.5);
}

YesNoBox {
    align: center middle;
    background: rgba(96, 0, 0, 0.4);
}

YesNoBox Vertical {
    height: 8;
    width: 50;
    background: $surface;
    border: thick $background 100%;
}

YesNoBox Label {
    align: center middle;
}

WriteNoteModal {
    align: center middle;
    background: rgba(0, 0, 96, 0.4);

    #wrapper {
        width: 80%;
        max-width: 100;
        max-height: 20;
        height: 80%;
        border: thick $accent 100%;
        background: $surface;
    }

    .project_note {
        max-height: initial !important;

        TextArea {
            height: 100%;
        }

        .adjust {
            height: 5;
        }
    }
}

#tags {
    height: 5;
    width: 100%;
}

#log_overlay {
    height: 80%;
    border: thick $background 80%;
    background: $surface;
}

.small_input {
    border:none;
    height: 1;
    background: $panel;
}

ConfirmMessageBox {
    align: right middle;
    background: $error 30%;
    Vertical {
        width: 60%;
        height: 80%;
        margin-right: 5;
        border: ascii $accent;
        background: $panel;
    }
    MarkdownViewer {
        margin-left: 1;
        padding: 0;
    }
    Checkbox {
        margin: 1;
        height: 3;
    }

    .buttons {
        height: 5;
    }
}