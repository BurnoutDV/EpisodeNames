TemplateScreen {
    #sidebar {
        width: 1fr;
        min-width: 32;
        margin-right: 1;

    }

    #helper {
        ListItem {
            height: 1;
        }
    }

    Tree, Input, TextArea, #presufix, #helper, #tag_collapse {
        border: none;
        border-top: outer $panel;
        border-title-align: left;
        border-title-color: $foreground-darken-3;
        border-left: outer $panel;
        border-right: outer $panel;
        &:focus {
              border-left: outer $accent;
              border-right: outer $accent;
              border-top: outer $accent;
              background: $surface-lighten-1;
          }
    }

    #presufix {
        height: 4;
        background: $surface;
        &:focus-within {
              border-left: outer $accent;
              border-right: outer $accent;
              border-top: outer $accent;
              background: $surface-lighten-1;
          }
    }

    #pattern_name {
    }

    #content {
        width: 3fr;
    }

    #filter { /*compact text input line */
        border: none;
        padding-left: 1;
        border-left: outer $panel;
        border-right: outer $panel;
        background: $surface;
        &:focus {
            border-left: outer $accent;
            border-right: outer $accent;
            background: $surface-lighten-1;
        }
    }

    #pattern {
        height: 15fr;
    }

    #tag_collapse {
        padding:0;
        padding-bottom: 1;
        &:focus-within {
              border-left: outer $accent;
              border-right: outer $accent;
              border-top: outer $accent;
              background: $surface-lighten-1;
          }
    }

    #tags {
        margin: 0;
        border: none;
        padding: 0;
        height: 6;
        width: 100%;
    }

    Label {
        height: 2;
        text-align: center;
        width: 100%;
    }
}